// Build settings shared by every build of the app.
//
// An organization's build can carry its OAuth client ID, so that people
// sign in without pasting it. Those values go in Local.xcconfig next to this
// file, which is not committed. See Local.xcconfig.example.

GCHAT_CLIENT_ID =
GCHAT_ORGANIZATION =

// Push delivery for an organization's build (docs/design.md): the address of
// the relay, and the Pub/Sub topic that Google publishes events to
// (projects/<project>/topics/<topic>). Both set in Local.xcconfig. Empty
// means that the app polls. Write the URL as https:/$()/host, see below.
GCHAT_RELAY_URL =
GCHAT_EVENTS_TOPIC =

// Link to the source code, shown in the About window when set. In xcconfig
// files "//" starts a comment, so write the URL as https:/$()/github.com/...
GCHAT_SOURCE_URL = https:/$()/github.com/michaeljmuller/gchat

// Automatic updates (docs/design.md). The address of the appcast, the file
// that lists the releases of an organization's build. Set in Local.xcconfig,
// written as https:/$()/host/path. Empty means that the app has no updater.
GCHAT_APPCAST_URL =

// The public half of the Sparkle key that signs every release
// (docs/prerequisites.md). Not a secret.
GCHAT_SPARKLE_PUBLIC_KEY =

#include? "Local.xcconfig"

# Copy to Release.env (not committed) and fill in. scripts/support/publish.sh uploads
# each release to this bucket (docs/release.md). The bucket is in
# S3-compatible object storage, and its objects are public.

# Hetzner endpoints look like https://<location>.your-objectstorage.com
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=
# The folder for this organization's build. GCHAT_APPCAST_URL in
# Local.xcconfig must name appcast.xml in this folder.
S3_PREFIX=example
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

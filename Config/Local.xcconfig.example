// Copy to Local.xcconfig (not committed) and fill in to build an
// organization's copy of the app with its OAuth client ID built in.
// Leave both empty, or skip the file, for a build that asks for the ID.

GCHAT_CLIENT_ID = 1234567890-abcdef.apps.googleusercontent.com
GCHAT_ORGANIZATION = Example Organization

// Optional: push delivery through a relay (docs/deployment.md). In xcconfig
// files "//" starts a comment, so write the URL with $() between the slashes.
GCHAT_RELAY_URL = https:/$()/relay.example.com
GCHAT_EVENTS_TOPIC = projects/my-project/topics/gchat-events

// Optional: automatic updates (docs/release.md). The appcast is in the folder
// that S3_PREFIX names in Config/Release.env.
GCHAT_APPCAST_URL = https:/$()/my-bucket.fsn1.your-objectstorage.com/example/appcast.xml

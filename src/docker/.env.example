# Copy to .env (not committed) and fill in. See docs/deployment-relay.md.

# Comma-separated OAuth client IDs of the GChat builds that may connect.
ALLOWED_CLIENT_IDS=1234567890-abcdef.apps.googleusercontent.com

# Comma-separated Workspace domains whose users may connect.
ALLOWED_DOMAINS=example.com

# The relay's Pub/Sub subscription.
PUBSUB_SUBSCRIPTION=projects/my-project/subscriptions/gchat-relay

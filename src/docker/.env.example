# Copy to .env (not committed) and fill in. See docs/deployment-relay.md.

# Comma-separated OAuth client IDs of the GChat builds that may connect.
ALLOWED_CLIENT_IDS=1234567890-abcdef.apps.googleusercontent.com

# Comma-separated Workspace domains whose users may connect.
ALLOWED_DOMAINS=example.com

# The service account that the push subscription signs its requests as.
PUSH_SERVICE_ACCOUNT=gchat-relay@my-project.iam.gserviceaccount.com

# The audience of those requests: the push endpoint URL, unless the push
# subscription sets another.
PUSH_AUDIENCE=https://gchat-relay.themullers.org/v1/pubsub/push

# The push subscription. Pushes from any other subscription are refused.
PUBSUB_SUBSCRIPTION=projects/my-project/subscriptions/gchat-relay
